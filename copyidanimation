-- Logic quét và cập nhật danh sách
local function updateList()
    -- Xóa danh sách cũ trước khi quét mới
    for _, item in ipairs(ScrollingFrame:GetChildren()) do
        if item:IsA("TextButton") or item:IsA("TextLabel") then 
            item:Destroy() 
        end
    end

    local animIds = {}
    local hash = {} -- Dùng bảng băm để lọc trùng ID cực chuẩn

    -- Hàm quét đệ quy
    local function scan(parent)
        for _, v in ipairs(parent:GetDescendants()) do
            if v:IsA("Animation") and v.AnimationId and v.AnimationId ~= "" then
                -- Trích xuất chuỗi số nguyên thuần túy từ AnimationId
                local cleanId = v.AnimationId:match("%d+")
                if cleanId and not hash[cleanId] then
                    hash[cleanId] = true
                    table.insert(animIds, {id = cleanId, name = v.Name})
                end
            end
        end
    end

    -- Các khu vực chứa asset chạy ngầm và map của game
    local services = {
        game:GetService("Workspace"),
        game:GetService("ReplicatedStorage"),
        game:GetService("ReplicatedFirst"),
        game:GetService("StarterGui"),
        game:GetService("StarterPack"),
        game:GetService("Players").LocalPlayer
    }

    for _, service in ipairs(services) do
        pcall(function() scan(service) end)
    end

    -- Tự động căn chỉnh độ dài thanh cuộn dựa trên số lượng ID tìm thấy
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, #animIds * 41)

    if #animIds == 0 then
        local NoAnim = Instance.new("TextLabel")
        NoAnim.Size = UDim2.new(1, 0, 0, 40)
        NoAnim.Text = "Không tìm thấy Animation nào!"
        NoAnim.TextColor3 = Color3.fromRGB(150, 150, 150)
        NoAnim.BackgroundTransparency = 1
        NoAnim.Font = Enum.Font.SourceSansItalic
        NoAnim.TextSize = 14
        NoAnim.Parent = ScrollingFrame
        return
    end

    -- Hiển thị danh sách lên menu
    for _, data in ipairs(animIds) do
        local ItemBtn = Instance.new("TextButton")
        ItemBtn.Size = UDim2.new(1, -8, 0, 35)
        ItemBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        ItemBtn.Text = "  [" .. data.name .. "] -> " .. data.id
        ItemBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        ItemBtn.TextSize = 14
        ItemBtn.Font = Enum.Font.SourceSans
        ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
        ItemBtn.Parent = ScrollingFrame

        local ItemCorner = Instance.new("UICorner")
        ItemCorner.CornerRadius = UDim.new(0, 5)
        ItemCorner.Parent = ItemBtn

        -- Sự kiện bấm để Copy trực tiếp
        ItemBtn.MouseButton1Click:Connect(function()
            if setclipboard then
                setclipboard(data.id)
                ItemBtn.Text = "  ✓ Đã copy thành công!"
                ItemBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
                task.wait(0.8)
                ItemBtn.Text = "  [" .. data.name .. "] -> " .. data.id
                ItemBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            else
                ItemBtn.Text = "  Executor không hỗ trợ setclipboard!"
                ItemBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
        end)
    end
end

-- Kích hoạt
RefreshBtn.MouseButton1Click:Connect(updateList)
updateList() -- Tự động quét luôn một lần khi vừa mới inject script vào game
